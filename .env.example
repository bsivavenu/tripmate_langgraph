# TripMate configuration.
# Copy this file to `.env` and fill in your own values:   cp .env.example .env
# Never commit `.env` (it is in .gitignore). This example file has no real secrets.

# ---------------------------------------------------------------- LLM
# Which provider to use: groq (default) or openai
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq)  ->  https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (only when LLM_PROVIDER=openai)  ->  https://platform.openai.com/api-keys
# "fast" = cheap model for parsing/budget extraction, "strong" = itinerary + final answer
OPENAI_API_KEY=
OPENAI_FAST_MODEL=
OPENAI_STRONG_MODEL=

# ---------------------------------------------------------------- Tools / MCP servers
# Tavily web search, used through the remote Tavily MCP server (hotels)  ->  https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# SerpApi Google Flights: real round-trip fares (free plan: 250 searches/month)  ->  https://serpapi.com
SERPAPI_API_KEY=your_serpapi_api_key

# OpenWeatherMap, used by our custom weather MCP server  ->  https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# AviationStack, used by the third-party AviationStack MCP server  ->  https://aviationstack.com
AVIATIONSTACK_API_KEY=your_aviationstack_api_key

# ---------------------------------------------------------------- Database
# PostgreSQL for LangGraph checkpoints (a hosted one such as Render or Supabase works).
# `sslmode=require` is added automatically if it is missing.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------- Optional
# Origin airport (IATA code) used when the request names no departure city
DEFAULT_ORIGIN_IATA=HYD

# LangSmith tracing (optional)  ->  https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripmate
